# Copy this file to .env for local development.

# ── Render (free tier): SMTP is blocked — use Resend instead ──
# 1. Sign up at https://resend.com
# 2. Create an API key
# 3. On Render → Environment, add:
#    EMAIL_PROVIDER=resend
#    RESEND_API_KEY=re_xxxxxxxx
#    RESEND_TO=johnkaithpogi@gmail.com
#    RESEND_FROM=Portfolio Contact <onboarding@resend.dev>
#
# onboarding@resend.dev only delivers to your Resend account email until you verify a domain.

EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
RESEND_TO=johnkaithpogi@gmail.com
RESEND_FROM=Portfolio Contact <onboarding@resend.dev>

# ── Local development: Gmail SMTP (works on your machine, not on Render free tier) ──
# App Password: https://myaccount.google.com/apppasswords

# EMAIL_PROVIDER=smtp
# SMTP_EMAIL=your@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
# SMTP_TO=your@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
